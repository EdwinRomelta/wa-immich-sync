# ---- Immich connection (required) ----
# Base URL of your Immich server.
#   Local run:                 http://localhost:2283
#   Docker -> Immich on host:  http://host.docker.internal:2283
#   Docker -> Immich in Docker: http://<immich-service-name>:2283
IMMICH_URL=http://localhost:2283
# Immich -> Account Settings -> API Keys -> New API Key
IMMICH_API_KEY=your-immich-api-key

# ---- Which groups to sync (required) ----
# Comma-separated WhatsApp group NAMES or JIDs.
# Names are convenient; a JID (...@g.us) is stable across renames and unambiguous.
# Discover names/JIDs with: npm run list-groups
WHITELIST_GROUPS=Your Group Name, <group-jid>@g.us

# ---- Backfill via exported-chat zip (optional) ----
# Dedicated group: drop a WhatsApp "Export chat (with media)" .zip there and the
# bot imports every photo/video (album = the zip's caption, else the default).
BACKFILL_GROUP_NAME=wa-immich-backfill

# ---- Sync options (optional; defaults shown) ----
# per-group = one album per group | single = one album (SINGLE_ALBUM_NAME) | none
ALBUM_MODE=per-group
SINGLE_ALBUM_NAME=WhatsApp
# Comma-separated subset of: image,video
MEDIA_TYPES=image,video
# Request WhatsApp history sync on link (best-effort; only history since bot joined)
BACKFILL=true

# ---- Storage paths (optional; defaults shown) ----
WA_AUTH_DIR=./data/auth
DEDUP_DB=./data/synced.db

# Mark each synced message in WhatsApp with this emoji reaction.
# Unset/empty = off (no reaction). Set to an emoji to enable.
# SYNC_REACTION_EMOJI=🔄

# ---- Outbox (media staged on disk until Immich accepts it) ----
# Directory for in-flight media. Files here are deleted once uploaded.
OUTBOX_DIR=./data/outbox
# How often the uploader drains the queue, and how many items per pass.
DRAIN_INTERVAL_MS=30000
DRAIN_BATCH_SIZE=10
# Per-item retry backoff when Immich is unavailable.
DRAIN_BASE_BACKOFF_MS=30000
DRAIN_MAX_BACKOFF_MS=3600000
# Retries a row must accumulate before its staged file (missing/empty/not a
# regular file) is treated as terminal and dropped instead of retried again.
# Guards against dropping a row too eagerly on a one-off race.
DRAIN_DROP_AFTER_ATTEMPTS=3
# Most rows a single drain tick may drop as terminal. Guards against a
# directory-wide outage (bad OUTBOX_DIR, unmounted volume, NAS offline)
# making every row look terminal at once and emptying the whole queue.
DRAIN_MAX_DROPS_PER_TICK=5

# --- Health and alerting (Phase 2) ---
# Liveness file the Docker HEALTHCHECK reads. Must NOT be inside OUTBOX_DIR.
HEALTH_FILE=./data/health.json
# How often the daemon stamps the heartbeat and checks the outbox backlog.
HEALTH_INTERVAL_MS=60000
# Heartbeat age at which the healthcheck reports unhealthy (1 hour).
HEALTH_STALE_MS=3600000

# Where alerts are sent. Unset = the bot's own number.
# ALERT_TARGET_JID=628123456789@s.whatsapp.net
# Minimum gap between repeats of one condition (6 hours).
ALERT_COOLDOWN_MS=21600000
# Queued items before alerting that Immich is not accepting uploads.
ALERT_OUTBOX_DEPTH=50
# Age of the oldest queued item before alerting (2 hours).
ALERT_OUTBOX_AGE_MS=7200000
# Consecutive WhatsApp reconnect failures before alerting.
ALERT_RECONNECT_FAILURES=10
# Per-group silence before a gap is reported (1 hour).
CATCHUP_GAP_THRESHOLD_MS=3600000
